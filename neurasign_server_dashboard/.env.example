# Existing .env is loaded by the Python API only. Never overwrite it.
# Keep the existing spellings; uppercase aliases are also accepted.
JEV_API_key=
Google_AI_API_key=

# Jev is the default when its existing credential is configured.
# Select deterministic explicitly only for offline operation or unit tests.
ROUTING_PROVIDER=jev
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=3

# Real Gemini analysis runs by default using Google_AI_API_key above.
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=25

# Research data stays disabled in the normal manager-facing app.
# Enable only in a private local development session.
RESEARCH_ENABLED=false

# The frontend receives ONLY this public API address (no credentials).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Company workspaces: Docker/make dev configure local Firebase emulators.
# Cloud deployment receives these as runtime variables (see docs/gcloud-deployment.md).
# NEURASIGN_ENV=production
# WORKSPACE_STORE=firestore
# FIREBASE_PROJECT_ID=your-future-project
# FIREBASE_WEB_API_KEY=public-firebase-web-key
# FIREBASE_AUTH_DOMAIN=your-future-project.firebaseapp.com
# API_INTERNAL_URL=http://127.0.0.1:8000
# Never set FIREBASE_AUTH_EMULATOR_HOST or FIRESTORE_EMULATOR_HOST in production.

# Wearable accounts (optional). OAuth credentials differ from Jev/Gemini API keys.
# Generate a Fernet key once; preserve it across restarts. Never commit its value.
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_PUBLIC_ORIGIN=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
